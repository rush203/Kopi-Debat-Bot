{
  "info": {
    "name": "Kopi Debate Bot API Tests",
    "description": "Comprehensive test collection for the debate bot API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Test 1: Flat Earth Debate",
      "item": [
        {
          "name": "1. Start Flat Earth Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has conversation_id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.conversation_id).to.exist;",
                  "    pm.collectionVariables.set(\"conversation_id\", jsonData.conversation_id);",
                  "});",
                  "",
                  "pm.test(\"Response has messages array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.be.an('array');",
                  "    pm.expect(jsonData.message.length).to.equal(2);",
                  "});",
                  "",
                  "pm.test(\"Bot agrees with flat earth position\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var botMessage = jsonData.message[1].message.toLowerCase();",
                  "    pm.expect(jsonData.message[1].role).to.equal('bot');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": null,\n  \"message\": \"I believe the Earth is flat and I can prove it with simple observations\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/debate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "debate"]
            },
            "description": "Start a new conversation about flat earth theory. Bot should take the position that earth is flat."
          },
          "response": []
        },
